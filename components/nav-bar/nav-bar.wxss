.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 10; display: flex; align-items: center; box-sizing: content-box; background: rgba(11,15,26,.85); }
.back { width: 80rpx; text-align: center; font-size: 48rpx; line-height: 1; }
.title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 600; padding-left: 0; }
.nav.clear { background: transparent; }
